@page "/attendees"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject IUserService UserService
@inject ISeatService SeatService
@inject ILanBoardNotifier Notifier

<PageTitle>Teilnehmer</PageTitle>

<div class="p-8">
    <h1 class="text-2xl font-bold text-white mb-6">Teilnehmer</h1>

    @if (_users is null)
    {
        <p class="text-gray-400 text-sm">Lade...</p>
    }
    else if (_users.Count == 0)
    {
        <p class="text-gray-400 text-sm">Keine Benutzer gefunden.</p>
    }
    else
    {
        <div class="flex flex-col gap-2">
            @foreach (var user in _users)
            {
                var seat = _seatByUser.GetValueOrDefault(user.Id);
                var steamUrl = SteamUrl(user);

                <div class="flex items-center gap-4 bg-gray-800 rounded-xl px-4 py-3 border border-gray-700">
                    <div class="relative shrink-0">
                        @if (user.AvatarUrl is not null)
                        {
                            <img src="@user.AvatarUrl" alt="Avatar" class="w-10 h-10 rounded-full"/>
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-gray-600 flex items-center justify-center text-sm text-white font-medium">
                                @user.DisplayName[..1]
                            </div>
                        }
                        @if (Notifier.OnlineUserIds.Contains(user.Id))
                        {
                            <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-500 rounded-full border-2 border-gray-800"></span>
                        }
                    </div>

                    <span class="flex-1 text-white font-medium truncate min-w-0">@user.DisplayName</span>

                    <span class="text-sm text-gray-400 shrink-0">
                        @(seat is not null ? seat.Label : "–")
                    </span>

                    @if (steamUrl is not null)
                    {
                        <a href="@steamUrl" target="_blank" rel="noopener noreferrer"
                           class="shrink-0 text-gray-400 hover:text-white transition-colors"
                           title="Steam-Profil">
                            <img src="/steam-logo.svg" alt="Steam" class="w-5 h-5"/>
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<User>? _users;
    private Dictionary<Guid, Seat> _seatByUser = [];

    protected override async Task OnInitializedAsync()
    {
        Notifier.OnChange += OnNotified;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _users = await UserService.GetAllWithIdentitiesAsync();
        var party = await SeatService.GetActivePartyWithSeatsAsync();
        _seatByUser = party?.Seats
            .Where(s => s.AssignedUserId is not null)
            .ToDictionary(s => s.AssignedUserId!.Value) ?? [];
    }

    private bool _loading;

    private void OnNotified()
    {
        if (_disposed || _loading) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _loading) return;
            _loading = true;
            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            finally
            {
                _loading = false;
            }
        });
    }

    private static string? SteamUrl(User user)
    {
        var identity = user.Identities.FirstOrDefault(i => i.Provider == "Steam");
        return identity is null ? null : $"https://steamcommunity.com/profiles/{identity.ProviderUserId}";
    }

    private volatile bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Notifier.OnChange -= OnNotified;
    }
}
