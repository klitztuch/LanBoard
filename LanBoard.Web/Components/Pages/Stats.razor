@page "/stats"
@attribute [Authorize]
@inject ISeatService SeatService
@inject IPartyStatsService StatsService

<PageTitle>@L["Stats.Title"]</PageTitle>

<div class="p-8">
    <h1 class="text-2xl font-bold text-white mb-6">@L["Stats.Title"]</h1>

    @if (_party is null || _stats is null)
    {
        <p class="text-gray-400 text-sm">@L["Home.NoActiveParty"]</p>
    }
    else
    {
        <div class="mb-6">
            <p class="text-gray-400 text-sm">
                @_party.Name · @L["Stats.TotalPlaytime", FormatDuration(_stats.TotalPlaytime)]
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <div>
                <h2 class="text-lg font-semibold text-white mb-3">@L["Stats.TopGames"]</h2>
                @if (_stats.TopGames.Count == 0)
                {
                    <p class="text-gray-500 text-sm">@L["Stats.NoData"]</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var game in _stats.TopGames)
                        {
                            <div class="flex items-center justify-between bg-gray-800 rounded-lg px-4 py-3 border border-gray-700">
                                <div>
                                    <p class="text-white font-medium">@game.GameName</p>
                                    <p class="text-xs text-gray-400">@L["Stats.PlayerCount", game.PlayerCount]</p>
                                </div>
                                <span class="text-sm text-gray-300 font-mono">@FormatDuration(game.TotalPlaytime)</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div>
                <h2 class="text-lg font-semibold text-white mb-3">@L["Stats.TopUsers"]</h2>
                @if (_stats.TopUsers.Count == 0)
                {
                    <p class="text-gray-500 text-sm">@L["Stats.NoData"]</p>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var user in _stats.TopUsers)
                        {
                            <div class="flex items-center gap-3 bg-gray-800 rounded-lg px-4 py-3 border border-gray-700">
                                @if (user.AvatarUrl is not null)
                                {
                                    <img src="@user.AvatarUrl" alt="@L["Nav.Avatar"]" class="w-8 h-8 rounded-full"/>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-gray-600 flex items-center justify-center text-xs text-white">
                                        @user.DisplayName[..1]
                                    </div>
                                }
                                <span class="flex-1 text-white font-medium truncate">@user.DisplayName</span>
                                <span class="text-sm text-gray-300 font-mono">@FormatDuration(user.TotalPlaytime)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public Guid? PartyId { get; set; }

    private LanParty? _party;
    private PartyStats? _stats;

    protected override async Task OnInitializedAsync()
    {
        _party = await SeatService.GetActivePartyWithSeatsAsync(PartyId);
        if (_party is not null)
            _stats = await StatsService.GetStatsAsync(_party.Id);
    }

    private string FormatDuration(TimeSpan duration)
        => duration.TotalHours >= 1
            ? L["Stats.Duration.HoursMinutes", (int)duration.TotalHours, duration.Minutes]
            : L["Stats.Duration.Minutes", duration.Minutes];
}
