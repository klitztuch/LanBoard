@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Error.Page.Title"]</PageTitle>

<h1 class="text-danger">@L["Error.Page.Title"]</h1>
<h2 class="text-danger">@L["Error.Page.Text"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["Error.Page.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["Error.Page.DevMode.Title"]</h3>
<p>@L["Error.Page.DevMode.Details"]</p>
<p>
    <strong>@L["Error.Page.DevMode.Warning"]</strong>
    @L["Error.Page.DevMode.HowTo"]
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}