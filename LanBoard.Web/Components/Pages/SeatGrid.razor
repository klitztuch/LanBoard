@rendermode InteractiveServer
@implements IDisposable
@inject ISeatService SeatService
@inject ISessionService SessionService
@inject IRsvpService RsvpService
@inject ILanBoardNotifier Notifier
@inject AuthenticationStateProvider Auth

@if (_userId is not null)
{
    <div class="flex items-center gap-3 bg-gray-800 rounded-xl px-4 py-3 border border-gray-700 mb-6">
        <span class="text-sm text-gray-300 flex-1">
            @(_isAttending switch
            {
                true => "Du hast zugesagt.",
                false => "Du hast abgesagt.",
                null => "Kommst du zur Party?"
            })
        </span>
        <button class="@RsvpButtonClass(true)" @onclick="() => SetRsvpAsync(true)">Ich komme</button>
        <button class="@RsvpButtonClass(false)" @onclick="() => SetRsvpAsync(false)">Ich komme nicht</button>
    </div>
}

@if (_seats is null)
{
    <p class="text-gray-400 text-sm">Lade Sitzplätze...</p>
}
else if (_seats.Count == 0)
{
    <p class="text-gray-400 text-sm">Keine Sitzplätze angelegt.</p>
}
else
{
    <div class="overflow-x-auto">
    <SeatGridLayout Seats="_seats" CellSize="9rem" GapSize="12px">
        <CellTemplate Context="cell">
            @if (cell.Seat is null)
            {
                <div></div>
            }
            else
            {
                var seat = cell.Seat;
                <div class="@SeatClass(seat) rounded-xl p-3 flex flex-col gap-2 h-full">
                    <span class="text-xs font-mono text-gray-400">@seat.Label</span>

                    @if (seat.AssignedUser is { } assignedUser && seat.AssignedUserId is { } assignedUserId)
                    {
                        <div class="flex items-center gap-2 flex-1">
                            <div class="relative shrink-0">
                                @if (assignedUser.AvatarUrl is not null)
                                {
                                    <img src="@assignedUser.AvatarUrl" alt="Avatar"
                                         class="w-8 h-8 rounded-full"/>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-gray-600 flex items-center justify-center text-xs text-white">
                                        @assignedUser.DisplayName[..1]
                                    </div>
                                }
                                @if (Notifier.OnlineUserIds.Contains(assignedUserId))
                                {
                                    <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-500 rounded-full border-2 border-gray-800"></span>
                                }
                                @if (_sessionsByUser.TryGetValue(assignedUserId, out var session))
                                {
                                    <span class="absolute -top-1 -right-1 text-[10px] leading-none bg-violet-600 rounded-full w-4 h-4 flex items-center justify-center border-2 border-gray-800"
                                          title="@(session.GameName ?? session.GameAppId)">
                                        🎮
                                    </span>
                                }
                            </div>
                            <span class="text-sm text-white truncate">@assignedUser.DisplayName</span>
                        </div>

                        @if (assignedUserId == _userId)
                        {
                            <button class="text-xs text-gray-400 hover:text-red-400 transition-colors text-left"
                                    @onclick="() => ReleaseSeat(seat.Id)">
                                Freigeben
                            </button>
                        }
                    }
                    else
                    {
                        <button class="flex-1 flex items-center justify-center text-sm text-gray-500 hover:text-white transition-colors"
                                @onclick="() => ClaimSeat(seat.Id)"
                                disabled="@(_userId is null)">
                            Frei
                        </button>
                    }
                </div>
            }
        </CellTemplate>
    </SeatGridLayout>
    </div>
}

@code {
    [Parameter] public Guid PartyId { get; set; }

    private List<Seat>? _seats;
    private Guid? _userId;
    private bool? _isAttending;
    private IReadOnlyDictionary<Guid, Session> _sessionsByUser = new Dictionary<Guid, Session>();

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst("lanboard:userid");
        if (claim is not null && Guid.TryParse(claim.Value, out var id))
            _userId = id;

        Notifier.OnChange += OnNotified;
        _loading = true;
        try
        {
            if (_userId is { } userId)
            {
                var rsvp = await RsvpService.GetMyRsvpAsync(userId, PartyId);
                _isAttending = rsvp?.IsAttending;
            }

            await LoadSeatsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetRsvpAsync(bool attending)
    {
        if (_userId is not { } userId) return;
        await RsvpService.SetRsvpAsync(userId, PartyId, attending);
        _isAttending = attending;
    }

    private string RsvpButtonClass(bool isYesButton)
    {
        const string baseClasses = "text-xs px-3 py-1.5 rounded-lg font-medium transition-colors ";
        if (_isAttending == isYesButton)
            return baseClasses + (isYesButton ? "bg-green-700 text-white" : "bg-red-900 text-white");
        return baseClasses + "bg-gray-700 text-gray-300 hover:bg-gray-600";
    }

    private async Task LoadSeatsAsync()
    {
        var result = await SeatService.GetSeatsByPartyAsync(PartyId);
        _seats = result.ToList();
        _sessionsByUser = await SessionService.GetActiveSessionsByPartyAsync(PartyId);
    }

    private bool _loading;

    private void OnNotified()
    {
        if (_disposed || _loading) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _loading) return;
            _loading = true;
            try
            {
                await LoadSeatsAsync();
                StateHasChanged();
            }
            finally
            {
                _loading = false;
            }
        });
    }

    private async Task ClaimSeat(Guid seatId)
    {
        if (_userId is null) return;
        await SeatService.ClaimSeatAsync(seatId, _userId.Value);
    }

    private async Task ReleaseSeat(Guid seatId)
    {
        if (_userId is null) return;
        await SeatService.ReleaseSeatAsync(seatId, _userId.Value);
    }

    private string SeatClass(Seat seat)
    {
        if (seat.AssignedUserId == _userId)
            return "bg-blue-900 border border-blue-600";
        if (seat.AssignedUser is not null)
            return "bg-gray-800 border border-gray-700";
        return "bg-gray-900 border border-gray-700 hover:border-gray-500 cursor-pointer";
    }

    private volatile bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        Notifier.OnChange -= OnNotified;
    }
}
