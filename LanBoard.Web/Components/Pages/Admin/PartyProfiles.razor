@page "/admin/profiles"
@page "/admin/profiles/{PartyId:guid}"
@attribute [Authorize(Policy = Permissions.ProfileRead)]
@rendermode InteractiveServer
@inherits ServicePageBase
@using LanBoard.Web.Extensions
@using Microsoft.Extensions.Options
@inject IAdminService AdminService
@inject IProfileService ProfileService
@inject IOptions<LanBoardLocalizationOptions> LocalizationOptions
@inject NavigationManager Nav

<PageTitle>@L["Admin.PartyProfiles.Title"] – @L["Nav.Admin"]</PageTitle>

<div class="p-8">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/admin" class="text-gray-400 hover:text-white transition-colors text-sm">← @L["Nav.Admin"]</a>
            <h1 class="text-2xl font-bold text-white">@L["Admin.PartyProfiles.Title"]</h1>
        </div>
        @if (_parties is { Count: > 0 })
        {
            <select aria-label="@L["Admin.PartyProfiles.Party"]" value="@_selectedPartyId" @onchange="SelectParty"
                    class="px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500">
                @foreach (var party in _parties)
                {
                    <option value="@party.Id">@party.Name (@party.Date.ToString("d"))</option>
                }
            </select>
        }
    </div>

    <ErrorBanner Message="@Error"/>

    @if (_parties is null)
    {
        <p class="text-gray-400 text-sm">@L["Common.Loading"]</p>
    }
    else if (_parties.Count == 0)
    {
        <p class="text-gray-400 text-sm">@L["Admin.Parties.None"]</p>
    }
    else if (_overview is not null)
    {
        @if (_overview.Rows.Count == 0)
        {
            <p class="text-gray-400 text-sm">@L["Admin.PartyProfiles.NoAttendees"]</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs text-gray-400 uppercase border-b border-gray-800">
                        <tr>
                            <th class="py-3 pr-6">@L["Admin.PartyProfiles.User"]</th>
                            @foreach (var column in _overview.Columns)
                            {
                                <th class="py-3 pr-6">@ProfileFieldLabels.For(column, LocalizationOptions.Value.DefaultCulture)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _overview.Rows)
                        {
                            <tr class="border-b border-gray-800 text-gray-300">
                                <td class="py-3 pr-6">
                                    <UserLink UserId="row.UserId" Name="@row.DisplayName" CssClass="text-white font-medium hover:underline"/>
                                </td>
                                @foreach (var column in _overview.Columns)
                                {
                                    <td class="py-3 pr-6">@(row.Values.TryGetValue(column.Id, out var value) ? ProfileFieldLabels.FormatValue(L, column.Type, value) : "–")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-xs text-gray-500">@L["Admin.PartyProfiles.Count", _overview.Rows.Count]</p>
        }
    }
</div>

@code {
    [Parameter] public Guid? PartyId { get; set; }

    private IReadOnlyList<LanParty>? _parties;
    private Guid? _selectedPartyId;
    private PartyProfileOverview? _overview;

    protected override async Task OnParametersSetAsync()
    {
        _parties ??= await AdminService.GetAllPartiesAsync();
        // Default: the active party, else the newest one.
        _selectedPartyId = PartyId
                           ?? _parties.FirstOrDefault(p => p.IsActive)?.Id
                           ?? _parties.FirstOrDefault()?.Id;
        _overview = null;
        if (_selectedPartyId is { } partyId)
        {
            var userId = await CurrentUserIdAsync();
            _overview = await RunAsync(() => ProfileService.GetPartyOverviewAsync(partyId, userId));
        }
    }

    private void SelectParty(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var partyId))
            Nav.NavigateTo($"/admin/profiles/{partyId}");
    }
}
