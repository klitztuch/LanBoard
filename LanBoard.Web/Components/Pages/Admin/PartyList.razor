@page "/admin/party"
@attribute [Authorize(Policy = Permissions.PartyManage)]
@rendermode InteractiveServer
@inherits ServicePageBase
@inject IAdminService AdminService

<PageTitle>@L["Admin.Parties.Title"] – @L["Nav.Admin"]</PageTitle>

<div class="p-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-white">@L["Admin.Parties.Title"]</h1>
        <a href="/admin/party/new"
           class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            @L["Admin.Parties.New"]
        </a>
    </div>

    <ErrorBanner Message="@Error" />

    @if (_parties is null)
    {
        <p class="text-gray-400">@L["Common.Loading"]</p>
    }
    else if (_parties.Count == 0)
    {
        <p class="text-gray-400">@L["Admin.Parties.None"]</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-gray-400 uppercase border-b border-gray-800">
                    <tr>
                        <th class="py-3 pr-6">@L["Admin.Parties.Name"]</th>
                        <th class="py-3 pr-6">@L["Admin.Parties.Date"]</th>
                        <th class="py-3 pr-6">@L["Admin.Parties.Location"]</th>
                        <th class="py-3 pr-6">@L["Admin.Parties.InviteCode"]</th>
                        <th class="py-3 pr-6">@L["Admin.Parties.Seats"]</th>
                        <th class="py-3 pr-6">@L["Admin.Parties.Active"]</th>
                        <th class="py-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var party in _parties)
                    {
                        <tr class="border-b border-gray-800 text-gray-300">
                            <td class="py-3 pr-6 text-white font-medium">@party.Name</td>
                            <td class="py-3 pr-6">@party.Date.ToString("d")</td>
                            <td class="py-3 pr-6">@party.Location</td>
                            <td class="py-3 pr-6 font-mono text-xs">@party.InviteCode</td>
                            <td class="py-3 pr-6">@party.Seats.Count</td>
                            <td class="py-3 pr-6">
                                @if (party.IsActive)
                                {
                                    <span class="px-2 py-0.5 bg-green-900 text-green-300 text-xs rounded-full border border-green-700">@L["Admin.Parties.Active"]</span>
                                }
                                else
                                {
                                    <button class="text-gray-500 hover:text-white transition-colors text-xs"
                                            @onclick="() => SetActive(party.Id)">
                                        @L["Admin.Parties.SetActive"]
                                    </button>
                                }
                            </td>
                            <td class="py-3 flex items-center gap-3">
                                <a href="/admin/party/@party.Id"
                                   class="text-blue-400 hover:text-blue-300 transition-colors">
                                    @L["Common.Edit"]
                                </a>
                                <AuthorizeView Policy="@Permissions.ProfileRead" Context="profileAuth">
                                    <a href="/admin/profiles/@party.Id"
                                       class="text-blue-400 hover:text-blue-300 transition-colors">
                                        @L["Admin.PartyProfiles.Link"]
                                    </a>
                                </AuthorizeView>
                                @if (_confirmDeleteId == party.Id)
                                {
                                    <button class="text-red-400 hover:text-red-300 transition-colors"
                                            @onclick="() => DeleteParty(party.Id)">
                                        @L["Common.Confirm"]
                                    </button>
                                    <button class="text-gray-400 hover:text-gray-300 transition-colors"
                                            @onclick="() => _confirmDeleteId = null">
                                        @L["Common.Cancel"]
                                    </button>
                                }
                                else
                                {
                                    <button class="text-gray-500 hover:text-red-400 transition-colors"
                                            @onclick="() => _confirmDeleteId = party.Id">
                                        @L["Common.Delete"]
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<LanParty>? _parties;
    private Guid? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        var result = await AdminService.GetAllPartiesAsync();
        _parties = result.ToList();
    }

    private async Task DeleteParty(Guid id)
    {
        _confirmDeleteId = null;
        if (await RunAsync(async () => await AdminService.DeletePartyAsync(id, await CurrentUserIdAsync())))
            _parties?.RemoveAll(p => p.Id == id);
    }

    private async Task SetActive(Guid id)
    {
        if (!await RunAsync(async () => await AdminService.SetActivePartyAsync(id, await CurrentUserIdAsync())))
            return;
        var result = await AdminService.GetAllPartiesAsync();
        _parties = result.ToList();
    }
}
