@page "/admin/locations"
@attribute [Authorize(Policy = Permissions.PartyManage)]
@rendermode InteractiveServer
@inherits ServicePageBase
@inject ILocationService LocationService

<PageTitle>@L["Admin.Locations.Title"] – @L["Nav.Admin"]</PageTitle>

<div class="p-8 max-w-3xl">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <a href="/admin" class="text-gray-400 hover:text-white transition-colors text-sm">← @L["Nav.Admin"]</a>
            <h1 class="text-2xl font-bold text-white">@L["Admin.Locations.Title"]</h1>
        </div>
        @if (!_editing)
        {
            <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors"
                    @onclick="() => StartEdit(null)">
                @L["Admin.Locations.New"]
            </button>
        }
    </div>

    <ErrorBanner Message="@Error" />

    @if (_editing)
    {
        <div class="bg-gray-800 rounded-xl border border-gray-700 p-5 mb-6 space-y-4">
            <h2 class="text-lg font-semibold text-white">@(_editLocation is null ? L["Admin.Locations.New"] : L["Admin.Locations.Edit"])</h2>
            <LocationForm @key="_editLocation" Location="_editLocation" OnSaved="SavedAsync" OnCancel="CancelEdit" />
        </div>
    }

    @if (_locations is null)
    {
        <p class="text-gray-400 text-sm">@L["Common.Loading"]</p>
    }
    else if (_locations.Count == 0)
    {
        <p class="text-gray-400 text-sm">@L["Admin.Locations.None"]</p>
    }
    else
    {
        <div class="flex flex-col gap-2">
            @foreach (var location in _locations)
            {
                <div class="flex items-start justify-between gap-4 bg-gray-800 rounded-xl px-4 py-3 border border-gray-700">
                    <div class="min-w-0">
                        <p class="text-white font-medium">@location.Name</p>
                        @if (location.Address is { } address)
                        {
                            <p class="text-sm text-gray-400 whitespace-pre-line">@address</p>
                        }
                    </div>
                    <div class="flex items-center gap-3 shrink-0 text-sm">
                        <button class="text-blue-400 hover:text-blue-300 transition-colors"
                                @onclick="() => StartEdit(location)">
                            @L["Common.Edit"]
                        </button>
                        @if (_confirmDeleteId == location.Id)
                        {
                            <button class="text-red-400 hover:text-red-300 transition-colors"
                                    @onclick="() => DeleteAsync(location.Id)">
                                @L["Common.Confirm"]
                            </button>
                            <button class="text-gray-400 hover:text-gray-300 transition-colors"
                                    @onclick="() => _confirmDeleteId = null">
                                @L["Common.Cancel"]
                            </button>
                        }
                        else
                        {
                            <button class="text-gray-500 hover:text-red-400 transition-colors"
                                    @onclick="() => _confirmDeleteId = location.Id">
                                @L["Common.Delete"]
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<Location>? _locations;
    private bool _editing;
    private Location? _editLocation;
    private Guid? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _locations = await LocationService.GetAllAsync();
    }

    private void StartEdit(Location? location)
    {
        Error = null;
        _editLocation = location;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editLocation = null;
    }

    private async Task SavedAsync(Guid _)
    {
        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid locationId)
    {
        _confirmDeleteId = null;
        var userId = await CurrentUserIdAsync();
        if (await RunAsync(() => LocationService.DeleteAsync(locationId, userId)))
            await LoadAsync();
    }
}
