@page "/admin/roles"
@attribute [Authorize(Policy = Permissions.RolesManage)]
@rendermode InteractiveServer
@inherits ServicePageBase
@inject IRoleService RoleService

<PageTitle>@L["Admin.Roles.Title"] – @L["Nav.Admin"]</PageTitle>

<div class="p-8 max-w-3xl">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <a href="/admin" class="text-gray-400 hover:text-white transition-colors text-sm">← @L["Nav.Admin"]</a>
            <h1 class="text-2xl font-bold text-white">@L["Admin.Roles.Title"]</h1>
        </div>
        @if (_editing is null)
        {
            <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors"
                    @onclick="StartCreate">
                @L["Admin.Roles.New"]
            </button>
        }
    </div>

    <ErrorBanner Message="@Error" />

    @if (_editing is not null)
    {
        <div class="bg-gray-800 rounded-xl border border-gray-700 p-5 mb-6 space-y-4">
            <h2 class="text-lg font-semibold text-white">@(_editing.RoleId is null ? L["Admin.Roles.New"] : L["Admin.Roles.Edit"])</h2>
            <div>
                <label class="block text-sm text-gray-400 mb-1">@L["Admin.Roles.Name"]</label>
                <input @bind="_editing.Name" maxlength="50"
                       class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
            </div>
            <div>
                <p class="text-sm text-gray-400 mb-2">@L["Admin.Roles.Permissions"]</p>
                <div class="flex flex-col gap-2">
                    @foreach (var key in Permissions.All)
                    {
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" checked="@_editing.Permissions.Contains(key)"
                                   @onchange="e => TogglePermission(key, (bool)(e.Value ?? false))" />
                            <span class="text-sm text-white">@PermissionLabel(key)</span>
                            <span class="text-xs text-gray-500 font-mono">@key</span>
                        </label>
                    }
                </div>
            </div>
            <div class="flex gap-3">
                <button class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors"
                        @onclick="SaveAsync">
                    @(_editing.RoleId is null ? L["Common.Create"] : L["Common.Save"])
                </button>
                <button class="px-5 py-2 text-gray-400 hover:text-white text-sm transition-colors"
                        @onclick="CancelEdit">
                    @L["Common.Cancel"]
                </button>
            </div>
        </div>
    }

    @if (_roles is null)
    {
        <p class="text-gray-400 text-sm">@L["Common.Loading"]</p>
    }
    else
    {
        <div class="flex flex-col gap-2">
            @foreach (var role in _roles)
            {
                <div class="flex items-start justify-between gap-4 bg-gray-800 rounded-xl px-4 py-3 border border-gray-700">
                    <div class="min-w-0">
                        <p class="text-white font-medium">
                            @role.Name
                            @if (role.IsSystem)
                            {
                                <span class="ml-2 px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded-full">@L["Admin.Roles.System"]</span>
                            }
                        </p>
                        <div class="flex flex-wrap gap-1 mt-2">
                            @foreach (var label in PermissionLabels(role))
                            {
                                <span class="px-2 py-0.5 bg-gray-900 border border-gray-700 text-gray-300 text-xs rounded-full">@label</span>
                            }
                        </div>
                    </div>
                    @if (!role.IsSystem)
                    {
                        <div class="flex items-center gap-3 shrink-0 text-sm">
                            <button class="text-blue-400 hover:text-blue-300 transition-colors"
                                    @onclick="() => StartEdit(role)">
                                @L["Common.Edit"]
                            </button>
                            @if (_confirmDeleteId == role.Id)
                            {
                                <button class="text-red-400 hover:text-red-300 transition-colors"
                                        @onclick="() => DeleteAsync(role.Id)">
                                    @L["Common.Confirm"]
                                </button>
                                <button class="text-gray-400 hover:text-gray-300 transition-colors"
                                        @onclick="() => _confirmDeleteId = null">
                                    @L["Common.Cancel"]
                                </button>
                            }
                            else
                            {
                                <button class="text-gray-500 hover:text-red-400 transition-colors"
                                        @onclick="() => _confirmDeleteId = role.Id">
                                    @L["Common.Delete"]
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<Role>? _roles;
    private RoleForm? _editing;
    private Guid? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _roles = await RoleService.GetAllAsync();
    }

    private IEnumerable<string> PermissionLabels(Role role)
        => role.IsSystem
            ? [L["Admin.Roles.AllPermissions"]]
            : role.Permissions.Select(PermissionLabel);

    // Keys no longer in the catalog (stale DB rows) show as the raw key.
    private string PermissionLabel(string key)
    {
        var label = L[$"Permission.{key}"];
        return label.ResourceNotFound ? key : label;
    }

    private void StartCreate()
    {
        Error = null;
        _editing = new RoleForm();
    }

    private void StartEdit(Role role)
    {
        Error = null;
        _editing = new RoleForm { RoleId = role.Id, Name = role.Name, Permissions = [.. role.Permissions] };
    }

    private void CancelEdit()
    {
        Error = null;
        _editing = null;
    }

    private void TogglePermission(string key, bool enabled)
    {
        if (enabled)
            _editing?.Permissions.Add(key);
        else
            _editing?.Permissions.Remove(key);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        var form = _editing;
        var userId = await CurrentUserIdAsync();

        var saved = await RunAsync(() => form.RoleId is { } roleId
            ? RoleService.UpdateAsync(roleId, form.Name, form.Permissions, userId)
            : RoleService.CreateAsync(form.Name, form.Permissions, userId));
        if (!saved) return;

        _editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid roleId)
    {
        _confirmDeleteId = null;
        var userId = await CurrentUserIdAsync();
        if (await RunAsync(() => RoleService.DeleteAsync(roleId, userId)))
            await LoadAsync();
    }

    private sealed class RoleForm
    {
        public Guid? RoleId { get; init; }
        public string Name { get; set; } = "";
        public HashSet<string> Permissions { get; init; } = [];
    }
}
