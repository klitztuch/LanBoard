@page "/admin/audit-log"
@attribute [Authorize(Policy = Permissions.AuditView)]
@inherits ServicePageBase
@inject IAdminService AdminService

<PageTitle>@L["Admin.AuditLog.Title"] – @L["Nav.Admin"]</PageTitle>

<div class="p-8">
    <div class="flex items-center gap-3 mb-6">
        <a href="/admin" class="text-gray-400 hover:text-white transition-colors text-sm">← @L["Nav.Admin"]</a>
        <h1 class="text-2xl font-bold text-white">@L["Admin.AuditLog.Title"]</h1>
    </div>

    <ErrorBanner Message="@Error" />

    @if (_entries is null)
    {
        if (Error is null)
        {
            <p class="text-gray-400 text-sm">@L["Common.Loading"]</p>
        }
    }
    else if (_entries.Count == 0)
    {
        <p class="text-gray-400 text-sm">@L["Admin.AuditLog.None"]</p>
    }
    else
    {
        <div class="flex flex-col gap-2 max-w-2xl">
            @foreach (var entry in _entries)
            {
                <div class="flex items-center gap-4 bg-gray-800 rounded-xl px-4 py-3 border border-gray-700">
                    <span class="text-xs text-gray-500 font-mono shrink-0 w-40">@entry.CreatedAt.ToLocalTime().ToString("g")</span>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-gray-700 text-gray-300 shrink-0">@ActionLabel(entry.Action)</span>
                    <span class="text-sm text-white flex-1">@entry.Details</span>
                    <UserLink UserId="entry.UserId" Name="@entry.User.DisplayName" CssClass="text-xs text-gray-400 shrink-0 hover:underline"/>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<AdminAuditLogEntry>? _entries;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUserIdAsync();
        _entries = await RunAsync(() => AdminService.GetRecentAuditLogAsync(userId));
    }

    // Unknown (e.g. retired) actions fall back to the raw code.
    private string ActionLabel(string action)
    {
        var label = L[$"Audit.{action}"];
        return label.ResourceNotFound ? action : label;
    }
}
