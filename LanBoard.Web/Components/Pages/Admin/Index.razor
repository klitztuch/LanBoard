@page "/admin"
@attribute [Authorize(Policy = "Admin")]

<PageTitle>Admin – LanBoard</PageTitle>

<div class="p-8">
    <h1 class="text-2xl font-bold text-white mb-6">Admin</h1>

    <div class="flex flex-col gap-3 max-w-md">
        <a href="/admin/party"
           class="flex items-center justify-between gap-4 bg-gray-800 hover:bg-gray-700 rounded-xl px-5 py-4 border border-gray-700 transition-colors">
            <div>
                <p class="text-white font-medium">LAN-Parties</p>
                <p class="text-sm text-gray-400">Parties anlegen, bearbeiten und Sitzplätze verwalten</p>
            </div>
            <span class="text-gray-500">→</span>
        </a>
        <a href="/tv" target="_blank"
           class="flex items-center justify-between gap-4 bg-gray-800 hover:bg-gray-700 rounded-xl px-5 py-4 border border-gray-700 transition-colors">
            <div>
                <p class="text-white font-medium">TV-Modus</p>
                <p class="text-sm text-gray-400">Vollbild-Ansicht für Beamer/TV, ohne Login</p>
            </div>
            <span class="text-gray-500">→</span>
        </a>
    </div>
</div>
