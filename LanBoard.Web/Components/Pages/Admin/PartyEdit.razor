@page "/admin/party/new"
@page "/admin/party/{Id:guid}"
@attribute [Authorize(Policy = Permissions.PartyManage)]
@rendermode InteractiveServer
@inherits ServicePageBase
@inject IAdminService AdminService
@inject ILocationService LocationService
@inject NavigationManager Nav

<PageTitle>@(_party is null ? L["Admin.Parties.New"] : _party.Name) – @L["Nav.Admin"]</PageTitle>

<div class="p-8 max-w-2xl">
    <div class="flex items-center gap-3 mb-6">
        <a href="/admin/party" class="text-gray-400 hover:text-white transition-colors text-sm">← @L["Admin.Parties.Title"]</a>
        <h1 class="text-2xl font-bold text-white">@(Id is null ? L["Admin.Parties.New"] : _party?.Name ?? L["Common.Edit"])</h1>
    </div>

    <ErrorBanner Message="@Error" />

    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="space-y-4">
        <DataAnnotationsValidator />

        <div>
            <label class="block text-sm text-gray-400 mb-1">@L["Admin.Parties.Name"]</label>
            <InputText @bind-Value="_form.Name"
                       class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-400 mb-1">@L["Admin.Parties.Date"]</label>
            <InputDate @bind-Value="_form.Date"
                       class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-400 mb-1">@L["Admin.Parties.Location"]</label>
            <div class="flex gap-3">
                <InputSelect @bind-Value="_form.LocationId" id="party-location"
                             class="flex-1 min-w-0 px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500">
                    <option value="">@L["Admin.PartyEdit.ChooseLocation"]</option>
                    @foreach (var location in _locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </InputSelect>
                <button type="button" @onclick="() => _showLocationModal = true"
                        class="shrink-0 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition-colors">
                    @L["Admin.Locations.New"]
                </button>
            </div>
            <ValidationMessage For="() => _form.LocationId" class="text-xs text-red-400 mt-1" />
        </div>
        @if (_party?.InviteCode is { } inviteCode)
        {
            <div>
                <label class="block text-sm text-gray-400 mb-1">@L["Admin.Parties.InviteCode"]</label>
                <p class="px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono text-sm">@inviteCode</p>
            </div>
        }
        <button type="submit"
                class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            @(Id is null ? L["Common.Create"] : L["Common.Save"])
        </button>
    </EditForm>
</div>

@if (_party is not null)
{
    <div class="p-8 pt-0 max-w-2xl">
        <h2 class="text-lg font-semibold text-white mb-4">@L["Admin.PartyEdit.InfoBoard"]</h2>
        <p class="text-xs text-gray-500 mb-3">@L["Admin.PartyEdit.InfoBoardHelp"]</p>
        <EditForm Model="_infoForm" OnValidSubmit="SaveInfoBoardAsync" class="flex flex-col gap-3">
            <InputTextArea @bind-Value="_infoForm.InfoBoard" rows="8" maxlength="4000"
                           class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500"/>
            <button type="submit"
                    class="self-start px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                @L["Admin.PartyEdit.SaveInfoBoard"]
            </button>
        </EditForm>
    </div>

    <div class="p-8 pt-0 max-w-5xl">
        <h2 class="text-lg font-semibold text-white mb-4">@L["Admin.PartyEdit.Seats"]</h2>
        <p class="text-xs text-gray-500 mb-4">@L["Admin.PartyEdit.SeatsHelp"]</p>

        @if (_displaySeats.Count == 0 && _seatPlanSources.Count > 0)
        {
            <div class="flex flex-wrap items-center gap-3 mb-4">
                <label for="seat-plan-source" class="text-sm text-gray-400">@L["Admin.PartyEdit.CopySeatPlanFrom"]</label>
                <select id="seat-plan-source" @bind="_copySourceId"
                        class="px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500">
                    <option value="">@L["Admin.PartyEdit.ChooseParty"]</option>
                    @foreach (var source in _seatPlanSources)
                    {
                        <option value="@source.Id">@source.Name (@source.Location.Name, @source.Date.ToString("d"))</option>
                    }
                </select>
                <button type="button" @onclick="CopySeatsAsync" disabled="@(_copySourceId is null)"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:hover:bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors">
                    @L["Admin.PartyEdit.CopySeatPlan"]
                </button>
            </div>
        }

        <SeatGridLayout Seats="_displaySeats" ShowExpandBorder="true" CellSize="2.5rem" GapSize="4px">
            <CellTemplate Context="cell">
                <div class="@CellClass(cell.Seat) h-full w-full" @onclick="() => ToggleSeat(cell.X, cell.Y, cell.Seat)">
                    @if (cell.Seat is not null)
                    {
                        <span class="text-xs font-mono leading-none">@cell.Seat.Label</span>
                    }
                </div>
            </CellTemplate>
        </SeatGridLayout>
    </div>
}

@if (_showLocationModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true">
        <div class="w-full max-w-lg max-h-full overflow-y-auto bg-gray-800 rounded-xl border border-gray-700 p-5 space-y-4">
            <h2 class="text-lg font-semibold text-white">@L["Admin.Locations.New"]</h2>
            <LocationForm OnSaved="LocationCreatedAsync" OnCancel="() => _showLocationModal = false" />
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private LanParty? _party;
    private List<Seat> _displaySeats = [];
    private IReadOnlyList<Location> _locations = [];
    private bool _showLocationModal;
    private IReadOnlyList<LanParty> _seatPlanSources = [];
    private Guid? _copySourceId;

    private readonly PartyForm _form = new();
    private readonly InfoBoardForm _infoForm = new();

    protected override async Task OnParametersSetAsync()
    {
        _locations = await LocationService.GetAllAsync();
        if (Id is not null)
        {
            _party = await AdminService.GetPartyWithSeatsAsync(Id.Value);
            if (_party is not null)
            {
                _form.Name = _party.Name;
                _form.Date = _party.Date;
                _form.LocationId = _party.LocationId;
                _infoForm.InfoBoard = _party.InfoBoard ?? "";
                _displaySeats = [.. _party.Seats];
                await LoadSeatPlanSourcesAsync();
            }
        }
    }

    private async Task LoadSeatPlanSourcesAsync()
    {
        if (_party is null || _displaySeats.Count > 0)
        {
            _seatPlanSources = [];
            return;
        }
        _seatPlanSources = SeatPlanSources.Candidates(_party, await AdminService.GetAllPartiesAsync());
        _copySourceId = SeatPlanSources.Default(_party, _seatPlanSources)?.Id;
    }

    // Only the selection changes: everything else typed into the party form stays as it is.
    private async Task LocationCreatedAsync(Guid locationId)
    {
        _showLocationModal = false;
        _locations = await LocationService.GetAllAsync();
        _form.LocationId = locationId;
    }

    private async Task CopySeatsAsync()
    {
        if (_party is null || _copySourceId is not { } sourceId) return;
        var userId = await CurrentUserIdAsync();
        if (await RunAsync(() => AdminService.CopySeatsAsync(_party.Id, sourceId, userId)))
            await ReloadSeatsAsync();
    }

    private async Task ReloadSeatsAsync()
    {
        if (Id is null) return;
        _party = await AdminService.GetPartyWithSeatsAsync(Id.Value);
        _displaySeats = [.. _party?.Seats ?? []];
        await LoadSeatPlanSourcesAsync();
    }

    private async Task SaveInfoBoardAsync()
    {
        if (Id is null) return;
        var userId = await CurrentUserIdAsync();
        await RunAsync(() => AdminService.UpdateInfoBoardAsync(Id.Value, _infoForm.InfoBoard, userId));
    }

    private async Task SaveAsync()
    {
        if (_form.LocationId is not { } locationId) return;   // [Required] already blocks the submit
        var userId = await CurrentUserIdAsync();

        if (Id is null)
        {
            if (await RunAsync(() => AdminService.CreatePartyAsync(_form.Name, _form.Date, locationId, userId)) is { } party)
                Nav.NavigateTo($"/admin/party/{party.Id}");
        }
        else if (await RunAsync(() => AdminService.UpdatePartyAsync(Id.Value, _form.Name, _form.Date, locationId, userId)))
        {
            await ReloadSeatsAsync();
        }
    }

    private async Task ToggleSeat(int x, int y, Seat? seat)
    {
        if (_party is null) return;

        if (seat is not null)
        {
            if (seat.AssignedUserId is not null) return;
            if (await RunAsync(async () => await AdminService.RemoveSeatAsync(seat.Id, await CurrentUserIdAsync())))
            {
                _displaySeats.RemoveAll(s => s.X == x && s.Y == y);
                if (_displaySeats.Count == 0)
                    await LoadSeatPlanSourcesAsync();
            }
        }
        else
        {
            var userId = await CurrentUserIdAsync();
            if (await RunAsync(() => AdminService.AddSeatAsync(_party.Id, x, y, userId)) is { } newSeat)
            {
                _displaySeats.Add(newSeat);
                _seatPlanSources = [];
            }
        }
    }

    private static string CellClass(Seat? seat) => seat switch
    {
        null => "flex items-center justify-center rounded border border-dashed border-gray-700 hover:border-gray-500 cursor-pointer transition-colors text-gray-700 hover:text-gray-500",
        { AssignedUserId: not null } => "flex items-center justify-center rounded bg-blue-900 border border-blue-600 text-blue-300 cursor-not-allowed",
        _ => "flex items-center justify-center rounded bg-gray-700 border border-gray-600 hover:bg-red-900 hover:border-red-600 cursor-pointer transition-colors text-gray-200"
    };

    private sealed class PartyForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        [System.ComponentModel.DataAnnotations.Required]
        public Guid? LocationId { get; set; }
    }

    private sealed class InfoBoardForm
    {
        public string InfoBoard { get; set; } = "";
    }
}
