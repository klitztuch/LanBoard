@page "/admin/party/new"
@page "/admin/party/{Id:guid}"
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inject IAdminService AdminService
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

<PageTitle>@(_party is null ? "Neue Party" : _party.Name) – Admin</PageTitle>

<div class="p-8 max-w-2xl">
    <div class="flex items-center gap-3 mb-6">
        <a href="/admin/party" class="text-gray-400 hover:text-white transition-colors text-sm">← Parties</a>
        <h1 class="text-2xl font-bold text-white">@(Id is null ? "Neue Party" : _party?.Name ?? "Bearbeiten")</h1>
    </div>

    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="space-y-4">
        <DataAnnotationsValidator />

        <div>
            <label class="block text-sm text-gray-400 mb-1">Name</label>
            <InputText @bind-Value="_form.Name"
                       class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-400 mb-1">Datum</label>
            <InputDate @bind-Value="_form.Date"
                       class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-400 mb-1">Ort</label>
            <InputText @bind-Value="_form.Location"
                       class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500" />
        </div>
        @if (_party?.InviteCode is { } inviteCode)
        {
            <div>
                <label class="block text-sm text-gray-400 mb-1">InviteCode</label>
                <p class="px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white font-mono text-sm">@inviteCode</p>
            </div>
        }
        <button type="submit"
                class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            @(Id is null ? "Erstellen" : "Speichern")
        </button>
    </EditForm>
</div>

@if (_party is not null)
{
    <div class="p-8 pt-0 max-w-5xl">
        <h2 class="text-lg font-semibold text-white mb-4">Sitzplätze</h2>
        <p class="text-xs text-gray-500 mb-4">Klick auf eine leere Zelle = Seat hinzufügen · Klick auf einen Seat = Seat entfernen</p>

        <SeatGridLayout Seats="_displaySeats" ShowExpandBorder="true" CellSize="2.5rem" GapSize="4px">
            <CellTemplate Context="cell">
                <div class="@CellClass(cell.Seat) h-full w-full" @onclick="() => ToggleSeat(cell.X, cell.Y, cell.Seat)">
                    @if (cell.Seat is not null)
                    {
                        <span class="text-xs font-mono leading-none">@cell.Seat.Label</span>
                    }
                </div>
            </CellTemplate>
        </SeatGridLayout>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private LanParty? _party;
    private List<Seat> _displaySeats = [];

    private readonly PartyForm _form = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Id is not null)
        {
            _party = await AdminService.GetPartyWithSeatsAsync(Id.Value);
            if (_party is not null)
            {
                _form.Name = _party.Name;
                _form.Date = _party.Date;
                _form.Location = _party.Location;
                _displaySeats = [.. _party.Seats];
            }
        }
    }

    private async Task SaveAsync()
    {
        if (Id is null)
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var userIdClaim = state.User.FindFirst("lanboard:userid")?.Value;
            if (!Guid.TryParse(userIdClaim, out var userId)) return;

            var party = await AdminService.CreatePartyAsync(_form.Name, _form.Date, _form.Location, userId);
            Nav.NavigateTo($"/admin/party/{party.Id}");
        }
        else
        {
            await AdminService.UpdatePartyAsync(Id.Value, _form.Name, _form.Date, _form.Location);
            _party = await AdminService.GetPartyWithSeatsAsync(Id.Value);
            _displaySeats = [.. _party?.Seats ?? []];
        }
    }

    private async Task ToggleSeat(int x, int y, Seat? seat)
    {
        if (_party is null) return;

        if (seat is not null)
        {
            if (seat.AssignedUserId is not null) return;
            await AdminService.RemoveSeatAsync(seat.Id);
            _displaySeats.RemoveAll(s => s.X == x && s.Y == y);
        }
        else
        {
            var newSeat = await AdminService.AddSeatAsync(_party.Id, x, y);
            _displaySeats.Add(newSeat);
        }
    }

    private static string CellClass(Seat? seat) => seat switch
    {
        null => "flex items-center justify-center rounded border border-dashed border-gray-700 hover:border-gray-500 cursor-pointer transition-colors text-gray-700 hover:text-gray-500",
        { AssignedUserId: not null } => "flex items-center justify-center rounded bg-blue-900 border border-blue-600 text-blue-300 cursor-not-allowed",
        _ => "flex items-center justify-center rounded bg-gray-700 border border-gray-600 hover:bg-red-900 hover:border-red-600 cursor-pointer transition-colors text-gray-200"
    };

    private sealed class PartyForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        [System.ComponentModel.DataAnnotations.Required]
        public string Location { get; set; } = "";
    }
}
