@page "/"
@inject ISeatService SeatService
@inject IPartyMembershipService MembershipService
@inject AuthenticationStateProvider Auth

<PageTitle>LanBoard</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_party is null)
        {
            <div class="p-4 md:p-8">
                <p class="text-gray-400">Keine aktive LAN-Party gefunden.</p>
            </div>
        }
        else if (!_hasAccess)
        {
            <div class="flex flex-col items-center justify-center h-full py-24 px-4">
                <h1 class="text-xl font-bold text-white mb-2">@_party.Name</h1>
                <p class="text-gray-400 text-sm mb-6 text-center max-w-sm">
                    Du brauchst den Invite-Code dieser Party, um Sitzplätze und Teilnehmer zu sehen.
                </p>
                <a href="/join?returnUrl=%2F"
                   class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                    Invite-Code eingeben
                </a>
            </div>
        }
        else
        {
            <div class="p-4 md:p-8">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-white">@_party.Name</h1>
                    <p class="text-gray-400 text-sm mt-1">@_party.Location · @_party.Date.ToString("dd.MM.yyyy")</p>
                </div>
                <SeatGrid PartyId="_party.Id"/>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="flex flex-col items-center justify-center h-full py-24">
            <h1 class="text-4xl font-bold text-white mb-3">LanBoard</h1>
            <p class="text-gray-400 mb-10">Your LAN party dashboard</p>
            <a href="/auth/login"
               class="flex items-center gap-3 px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg border border-gray-700 transition-colors">
                <img src="/steam-logo.svg" alt="Steam" class="w-5 h-5"/>
                Sign in with Steam
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [SupplyParameterFromQuery] public Guid? PartyId { get; set; }

    private LanParty? _party;
    private bool _hasAccess;

    protected override async Task OnInitializedAsync()
    {
        _party = await SeatService.GetActivePartyWithSeatsAsync(PartyId);
        if (_party is null) return;

        var state = await Auth.GetAuthenticationStateAsync();
        if (state.User.HasClaim("lanboard:isadmin", "true"))
        {
            _hasAccess = true;
            return;
        }

        var userIdClaim = state.User.FindFirst("lanboard:userid")?.Value;
        _hasAccess = Guid.TryParse(userIdClaim, out var userId)
            && await MembershipService.IsMemberAsync(userId, _party.Id);
    }
}
