@page "/info"
@attribute [Authorize]
@inject ISeatService SeatService

<PageTitle>@L["Info.Title"]</PageTitle>

<div class="p-8 max-w-2xl">
    <h1 class="text-2xl font-bold text-white mb-6">@L["Info.Title"]</h1>

    @if (_party is null)
    {
        <p class="text-gray-400 text-sm">@L["Home.NoActiveParty"]</p>
    }
    else if (string.IsNullOrWhiteSpace(_party.InfoBoard))
    {
        <p class="text-gray-400 text-sm">@L["Info.Empty", _party.Name]</p>
    }
    else
    {
        <div class="bg-gray-800 rounded-xl p-5 border border-gray-700 text-gray-200 text-sm whitespace-pre-wrap">@_party.InfoBoard</div>
    }

    @if (_party?.Location is { } location)
    {
        <section id="location" class="mt-8 bg-gray-800 rounded-xl p-5 border border-gray-700 text-sm">
            <h2 class="text-lg font-semibold text-white mb-1">@L["Info.Location"]</h2>
            <p class="text-white font-medium">@location.Name</p>
            @if (location.Address is { } address)
            {
                <p class="text-gray-300 whitespace-pre-wrap mt-1">@address</p>
            }
            @if (MapsLinks.Directions(location) is { } directionsUrl)
            {
                <a href="@directionsUrl" target="_blank" rel="noopener noreferrer"
                   class="inline-block mt-3 text-blue-400 hover:text-blue-300 transition-colors">
                    @L["Info.Location.Route"] ↗
                </a>
            }
            @foreach (var (heading, text) in Details(location))
            {
                <h3 class="text-gray-400 font-medium mt-4 mb-1">@heading</h3>
                <div class="text-gray-200 whitespace-pre-wrap">@text</div>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery] public Guid? PartyId { get; set; }

    private LanParty? _party;

    protected override async Task OnInitializedAsync()
    {
        _party = await SeatService.GetActivePartyWithSeatsAsync(PartyId);
    }

    private IEnumerable<(string Heading, string Text)> Details(Location location)
    {
        if (location.Directions is { } directions) yield return (L["Location.Directions"], directions);
        if (location.Parking is { } parking) yield return (L["Location.Parking"], parking);
        if (location.Notes is { } notes) yield return (L["Location.Notes"], notes);
    }
}
