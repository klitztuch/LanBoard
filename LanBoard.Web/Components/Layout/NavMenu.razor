<div class="flex flex-col h-full">
    <div class="px-4 py-5 border-b border-gray-800">
        <a href="/" class="text-xl font-bold text-white tracking-tight">LanBoard</a>
    </div>

    <nav class="flex-1 px-2 py-4">
        <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
                 ActiveClass="bg-gray-800 text-white">
            Home
        </NavLink>
    </nav>

    <div class="border-t border-gray-800 p-4">
        <AuthorizeView>
            <Authorized>
                <div class="flex items-center gap-3">
                    @if (context.User.FindFirst("urn:steam:avatar:full")?.Value is { } avatarUrl)
                    {
                        <img src="@avatarUrl" alt="Avatar" class="w-8 h-8 rounded-full flex-shrink-0"/>
                    }
                    <p class="flex-1 text-sm font-medium text-white truncate min-w-0">@context.User.Identity?.Name</p>
                    <a href="/auth/logout" class="text-xs text-gray-400 hover:text-white flex-shrink-0 transition-colors">Logout</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/auth/login"
                   class="flex items-center justify-center w-full px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                    Login with Steam
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
