@rendermode InteractiveServer
@implements IDisposable
@inject ILanBoardNotifier Notifier
@inject INotificationPublisher Publisher
@inject AuthenticationStateProvider Auth

@code {
    private Guid? _userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (state.User.GetUserId() is not { } id) return;
        _userId = id;
        // The name claim is the effective display name (re-issued on nickname changes), so no DB read here.
        if (Notifier.SetUserOnline(id))
            Publisher.Publish(new NotificationMessage(NotificationCategories.AttendeeOnline, id, [state.User.Identity?.Name ?? "?"]));
    }

    public void Dispose()
    {
        if (_userId.HasValue)
            Notifier.SetUserOffline(_userId.Value);
    }
}
