<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>da741c02-196f-4033-a267-c9f04bf12a45</UserSecretsId>
        <!-- DCP and dashboard come from NuGet, so CI builds without an installed Aspire CLI. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
        <PackageReference Include="SonarAnalyzer.CSharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\LanBoard.Web\LanBoard.Web.csproj" IsAspireProjectResource="true" />
    </ItemGroup>

</Project>
